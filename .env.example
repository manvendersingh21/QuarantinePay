# Local replay is explicit and never contacts PayPal.
QP_MODE=replay
DATABASE_URL=postgres://quarantinepay:quarantinepay@127.0.0.1/quarantinepay
# Must equal the browser origin exactly (login and form posts check Origin).
# HTTPS is only required for PayPal webhooks.
QP_PUBLIC_BASE=http://localhost:3000
# QP_BIND wins; if unset/empty the server binds 0.0.0.0:$PORT when PORT is set.
# The Dockerfile sets QP_BIND=0.0.0.0:3000; render.yaml pins 0.0.0.0:10000 (see docs/DEPLOY.md).
QP_BIND=127.0.0.1:3000
# Set a long random value (>= 24 chars); used for local single-buyer login and API bearer auth.
# If empty, one is generated in .local/admin-password.
QP_ADMIN_PASSWORD=

# PayPal Sandbox only (QP_MODE=sandbox). In replay mode leave them unset or empty;
# an empty PAYPAL_MERCHANT_ID is treated as unset, so the replay merchant is used.
# All three must come from the same Sandbox business account; the merchant ID has 13 characters.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MERCHANT_ID=
# Optional; webhooks need an HTTPS QP_PUBLIC_BASE. Settlement does not depend on them.
# PAYPAL_WEBHOOK_ID=

# Private mode keeps prompts, planner input and delivery analysis local. PayPal still receives payment fields.
# The agent planner and delivery analyst use this model; if it is unreachable they fall back to
# labelled rules. The model never has payment authority.
QP_PRIVATE_INFERENCE=true
QP_INFERENCE_PROVIDER=local
# Must be a loopback IP literal in private mode.
QP_LOCAL_LLM_BASE=http://127.0.0.1:11434
QP_LOCAL_MODEL=qwen3:30b-instruct
# Cloud Muse requires QP_PRIVATE_INFERENCE=false and QP_INFERENCE_PROVIDER=muse.
MUSE_API_KEY=
MUSE_API_BASE=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.1
# Channel3 import is discovery-only and separate from settlement.
CHANNEL3_API_KEY=
QP_CATALOG_SEED_QUERY=developer tools
ELASTIC_URL=
ELASTIC_API_KEY=
# Production: docker. local: trusted-process (only parses bounded JSON, no asset execution)
QP_VERIFIER_MODE=trusted-process
QP_VERIFIER_BIN=target/debug/quarantinepay-verifier

# Optional, read-only Shopify partner development store; never a payment connector.
SHOPIFY_DEV_STORE=
SHOPIFY_ADMIN_ACCESS_TOKEN=
