# Local replay is explicit and never contacts PayPal.
QP_MODE=replay
DATABASE_URL=postgres://quarantinepay:quarantinepay@127.0.0.1/quarantinepay
QP_PUBLIC_BASE=http://localhost:3000
QP_BIND=127.0.0.1:3000
# Set a long random value; used for local single-buyer login and API bearer auth.
QP_ADMIN_PASSWORD=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
# Private mode keeps prompts and catalog queries local. PayPal still receives payment fields.
QP_PRIVATE_INFERENCE=true
QP_INFERENCE_PROVIDER=local
QP_LOCAL_LLM_BASE=http://127.0.0.1:11434
QP_LOCAL_MODEL=qwen3:30b-instruct
# Cloud Muse requires QP_PRIVATE_INFERENCE=false and QP_INFERENCE_PROVIDER=muse.
MUSE_API_KEY=
MUSE_API_BASE=https://api.meta.ai/v1
MUSE_MODEL=muse-spark-1.1
CHANNEL3_API_KEY=
QP_CATALOG_SEED_QUERY=developer tools
ELASTIC_URL=
ELASTIC_API_KEY=
# Production: docker. local: trusted-process (only parses bounded JSON, no asset execution)
QP_VERIFIER_MODE=trusted-process
QP_VERIFIER_BIN=target/debug/quarantinepay-verifier

# Optional, read-only Shopify partner development store; never a payment connector.
SHOPIFY_DEV_STORE=
SHOPIFY_ADMIN_ACCESS_TOKEN=
