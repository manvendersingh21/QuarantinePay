{
  "openapi": "3.1.0",
  "info": {
    "title": "QuarantinePay",
    "version": "0.2.0",
    "description": "Fictional commerce scenarios and signed intents. Replay payments are simulated; optional PayPal Sandbox is separate. Capture and void are internal operations."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/catalog/search": {
      "get": {
        "summary": "Search the local demo catalog or explicitly enabled Channel3 catalog",
        "operationId": "LiveApiCatalogSearch",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/api/agent/runs": {
      "post": {
        "summary": "Recommendation without payment authority",
        "operationId": "MuseApiAgentRuns",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Search"
              }
            }
          }
        },
        "description": "Private mode uses the local Qwen model with no cloud fallback. Muse requires explicit opt-in to external inference."
      }
    },
    "/api/intents": {
      "post": {
        "summary": "Buyer confirms a server-allowlisted intent",
        "operationId": "BuyerApiIntents",
        "responses": {
          "200": {
            "description": "Accepted request or current state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedIntent"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirmation"
              }
            }
          }
        }
      }
    },
    "/api/checkout": {
      "post": {
        "summary": "Consume signed intent and queue order creation",
        "operationId": "ConsumeApiCheckout",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignedIntent"
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "summary": "Inspect durable payment state",
        "operationId": "InspectApiOrders{Id}",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/orders/{id}/authorize": {
      "post": {
        "summary": "Queue authorization after buyer approval",
        "operationId": "QueueApiOrders{Id}Authorize",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/orders/{id}/deliveries": {
      "post": {
        "summary": "Submit a scenario delivery as JSON data",
        "operationId": "SubmitApiOrders{Id}Deliveries",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {},
              "examples": {
                "dataset": {
                  "value": {
                    "csv": "id,date,value\n1,2026-01-01,10\n2,2026-01-02,12\n"
                  }
                },
                "report": {
                  "value": {
                    "file": "market-report.md",
                    "content": "# Executive summary\nDemand increased.\n# Findings\nTwo markets grew.\n"
                  }
                },
                "api-data": {
                  "value": {
                    "records": [
                      {
                        "id": "a",
                        "temperature": 20
                      },
                      {
                        "id": "b",
                        "temperature": 21
                      }
                    ]
                  }
                },
                "freelance": {
                  "value": {
                    "file": "design.zip",
                    "description": "First milestone"
                  }
                },
                "physical": {
                  "value": {
                    "status": "delivered",
                    "tracking": "SIM-12345"
                  }
                }
              }
            }
          }
        },
        "description": "An authorized order accepts one JSON artifact up to 64 KiB before its deadline. Data is checked asynchronously against its signed scenario terms. The API accepts arbitrary JSON; failure to meet the terms leads to a failed verification. The report contains Markdown text, while freelance file evidence is a simulated filename and description."
      }
    },
    "/api/events": {
      "get": {
        "summary": "Stream durable audit events",
        "operationId": "StreamApiEvents",
        "responses": {
          "200": {
            "description": "Audit stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ]
      }
    },
    "/api/webhooks/paypal": {
      "post": {
        "summary": "Verify and deduplicate provider webhook",
        "operationId": "VerifyApiWebhooksPaypal",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [],
        "description": "Requires PayPal transmission signature headers and successful PayPal verification. Disabled in replay mode.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "/api/catalog/sync": {
      "post": {
        "summary": "Import a public catalog using the configured operator seed",
        "operationId": "ImportChannel3Catalog",
        "description": "Authenticated operator action. Sends QP_CATALOG_SEED_QUERY and CHANNEL3_API_KEY to Channel3. No buyer search is sent. Screened products are stored locally for private searches; they are discovery-only and cannot be checked out.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Import counts and screening results"
          },
          "400": {
            "description": "Missing Channel3 key or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/scenarios": {
      "get": {
        "summary": "List the five fictional server-priced scenarios",
        "operationId": "listScenarios",
        "security": [],
        "responses": {
          "200": {
            "description": "Scenario catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScenarioTerms"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}/review": {
      "post": {
        "summary": "Approve or reject a delivery awaiting buyer review",
        "description": "Requires an authenticated administrator, a buyer_review state, and an unexpired deadline and intent. Approval queues capture; rejection queues void. Provider settlement remains asynchronous.",
        "operationId": "reviewOrder",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "decision"
                ],
                "properties": {
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approve",
                      "reject"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Decision recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "decision"
                  ],
                  "properties": {
                    "decision": {
                      "type": "string",
                      "enum": [
                        "approve",
                        "reject"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid decision"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Order is not awaiting timely review"
          }
        }
      }
    },
    "/api/shopify/dev-store": {
      "get": {
        "summary": "Read products and test orders from a configured Shopify partner development store",
        "description": "Read-only; Shopify must confirm partnerDevelopment. Requires a user-controlled store and Admin API token with read_products and read_orders. Returns at most ten products and ten test orders; no Shopify checkout or payment is linked to QuarantinePay settlement. Not externally tested without credentials.",
        "operationId": "readShopifyDevStore",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Shopify-confirmed development-store data; not QuarantinePay settlement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "source",
                    "externally_confirmed",
                    "notice",
                    "products",
                    "test_orders"
                  ],
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "externally_confirmed": {
                      "type": "boolean",
                      "const": true
                    },
                    "notice": {
                      "type": "string"
                    },
                    "products": {
                      "type": "array",
                      "maxItems": 10,
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "title"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "test_orders": {
                      "type": "array",
                      "maxItems": 10,
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "test",
                          "financial_status"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "test": {
                            "type": "boolean",
                            "const": true
                          },
                          "financial_status": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Unconfigured, invalid, or unavailable development store"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Intent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "id",
          "buyer",
          "sku",
          "merchant_id",
          "amount_minor",
          "currency",
          "expires_at",
          "policy_digest"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "buyer": {
            "type": "string"
          },
          "sku": {
            "type": "string",
            "enum": [
              "dataset",
              "report",
              "api-data",
              "freelance",
              "physical",
              "invoice-fixture-v1"
            ]
          },
          "merchant_id": {
            "type": "string"
          },
          "amount_minor": {
            "type": "integer",
            "const": 100
          },
          "currency": {
            "type": "string",
            "const": "USD"
          },
          "expires_at": {
            "type": "integer"
          },
          "policy_digest": {
            "type": "string"
          },
          "scenario": {
            "$ref": "#/components/schemas/ScenarioTerms",
            "description": "Signed acceptance terms for scenario orders; absent on legacy invoice intents."
          }
        }
      },
      "SignedIntent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent",
          "signature"
        ],
        "properties": {
          "intent": {
            "$ref": "#/components/schemas/Intent"
          },
          "signature": {
            "type": "string",
            "description": "Hex Ed25519 signature"
          }
        }
      },
      "Confirmation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "merchant_id",
          "amount_minor",
          "currency",
          "confirmed"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "enum": [
              "dataset",
              "report",
              "api-data",
              "freelance",
              "physical",
              "invoice-fixture-v1"
            ]
          },
          "merchant_id": {
            "type": "string"
          },
          "amount_minor": {
            "type": "integer",
            "const": 100
          },
          "currency": {
            "type": "string",
            "const": "USD"
          },
          "confirmed": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "Search": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "Invoice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "currency",
          "total_minor",
          "lines"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "currency": {
            "type": "string",
            "const": "USD"
          },
          "total_minor": {
            "type": "integer",
            "const": 100
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quantity",
                "unit_price_minor"
              ],
              "properties": {
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                },
                "unit_price_minor": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "ScenarioTerms": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "seller",
          "item",
          "amount_minor",
          "terms",
          "review_required",
          "deadline_seconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "dataset",
              "report",
              "api-data",
              "freelance",
              "physical"
            ]
          },
          "seller": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "amount_minor": {
            "type": "integer",
            "const": 100
          },
          "terms": {
            "type": "string"
          },
          "review_required": {
            "type": "boolean"
          },
          "deadline_seconds": {
            "type": "integer",
            "const": 120
          }
        }
      }
    }
  }
}
