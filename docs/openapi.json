{
  "openapi": "3.1.0",
  "info": {
    "title": "QuarantinePay",
    "version": "0.1.0",
    "description": "Sandbox-only signed-intent payment gateway. Capture and void are internal operations."
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/api/catalog/search": {
      "get": {
        "summary": "Search the local demo catalog or explicitly enabled Channel3 catalog",
        "operationId": "LiveApiCatalogSearch",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          }
        ]
      }
    },
    "/api/agent/runs": {
      "post": {
        "summary": "Recommendation without payment authority",
        "operationId": "MuseApiAgentRuns",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Search"
              }
            }
          }
        },
        "description": "Private mode uses the local Qwen model with no cloud fallback. Muse requires explicit opt-in to external inference."
      }
    },
    "/api/intents": {
      "post": {
        "summary": "Buyer confirms a server-allowlisted intent",
        "operationId": "BuyerApiIntents",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirmation"
              }
            }
          }
        }
      }
    },
    "/api/checkout": {
      "post": {
        "summary": "Consume signed intent and queue order creation",
        "operationId": "ConsumeApiCheckout",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignedIntent"
              }
            }
          }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "summary": "Inspect durable payment state",
        "operationId": "InspectApiOrders{Id}",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/orders/{id}/authorize": {
      "post": {
        "summary": "Queue authorization after buyer approval",
        "operationId": "QueueApiOrders{Id}Authorize",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/orders/{id}/deliveries": {
      "post": {
        "summary": "Submit JSON invoice artifact",
        "operationId": "SubmitApiOrders{Id}Deliveries",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Invoice"
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "summary": "Stream durable audit events",
        "operationId": "StreamApiEvents",
        "responses": {
          "200": {
            "description": "Audit stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          }
        ]
      }
    },
    "/api/webhooks/paypal": {
      "post": {
        "summary": "Verify and deduplicate provider webhook",
        "operationId": "VerifyApiWebhooksPaypal",
        "responses": {
          "200": {
            "description": "Accepted request or current state"
          },
          "400": {
            "description": "Invalid request or unavailable integration"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State conflict or consumed intent"
          }
        },
        "security": [],
        "description": "Requires PayPal transmission signature headers and successful PayPal verification. Disabled in replay mode.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Intent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "id",
          "buyer",
          "sku",
          "merchant_id",
          "amount_minor",
          "currency",
          "expires_at",
          "policy_digest"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "buyer": {
            "type": "string"
          },
          "sku": {
            "type": "string",
            "const": "invoice-fixture-v1"
          },
          "merchant_id": {
            "type": "string"
          },
          "amount_minor": {
            "type": "integer",
            "const": 100
          },
          "currency": {
            "type": "string",
            "const": "USD"
          },
          "expires_at": {
            "type": "integer"
          },
          "policy_digest": {
            "type": "string"
          }
        }
      },
      "SignedIntent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent",
          "signature"
        ],
        "properties": {
          "intent": {
            "$ref": "#/components/schemas/Intent"
          },
          "signature": {
            "type": "string",
            "description": "Hex Ed25519 signature"
          }
        }
      },
      "Confirmation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "merchant_id",
          "amount_minor",
          "currency",
          "confirmed"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "const": "invoice-fixture-v1"
          },
          "merchant_id": {
            "type": "string"
          },
          "amount_minor": {
            "type": "integer",
            "const": 100
          },
          "currency": {
            "type": "string",
            "const": "USD"
          },
          "confirmed": {
            "type": "boolean",
            "const": true
          }
        }
      },
      "Search": {
        "type": "object",
        "required": [
          "query"
        ],
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000
          }
        }
      },
      "Invoice": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "currency",
          "total_minor",
          "lines"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "const": 1
          },
          "currency": {
            "type": "string",
            "const": "USD"
          },
          "total_minor": {
            "type": "integer",
            "const": 100
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "quantity",
                "unit_price_minor"
              ],
              "properties": {
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                },
                "unit_price_minor": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
